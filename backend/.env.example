# ── Server ────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
DEBUG=false

# ── Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
CONVERTED_DIR=converted
MAX_UPLOAD_SIZE_MB=150

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your Vercel deployment URL in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Cleanup ───────────────────────────────────────────────────────────────
CLEANUP_INTERVAL_SECONDS=1800
FILE_TTL_SECONDS=7200

# ── OCR ──────────────────────────────────────────────────────────────────
OCR_WARM_UP_ON_STARTUP=true
OCR_IMAGE_TIMEOUT_S=60

# ── Conversion timeouts ───────────────────────────────────────────────────
MARKITDOWN_TIMEOUT_S=120
